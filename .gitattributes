# Make line-ending handling explicit and portable, so it does not depend on
# each developer's core.autocrlf setting and `cargo fmt` never churns on EOL.
# Text files are stored with LF in the repo; checkout EOL is native. Windows-only
# scripts stay CRLF. To normalize already-tracked files once:  git add --renormalize .
* text=auto

*.rs   text
*.toml text
*.md   text
*.json text

*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf

*.png  binary
*.jpg  binary
*.jpeg binary
*.ico  binary
*.gif  binary
